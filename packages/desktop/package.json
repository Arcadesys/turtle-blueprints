{
  "name": "@tb/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Design ComputerCraft turtle builds with Claude, view them in 3D and test them.",
  "author": "Austen Tucker",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win"
  },
  "devDependencies": {
    "@tb/assets": "*",
    "@tb/blueprint": "*",
    "@tb/mcp": "*",
    "@tb/web": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "*"
  },
  "build": {
    "appId": "com.arcadesys.turtle-blueprints",
    "productName": "Turtle Blueprints",
    "directories": { "output": "release" },
    "files": ["dist/**", "package.json"],
    "asarUnpack": ["dist/mcp.cjs", "dist/assets-worker.cjs"],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.developer-tools"
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}
